<group name="windows,sysmon,process_monitoring,">
  <rule id="100101" level="7">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)\\powershell\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">SOC-LAB-TEST-002</field>
    <description>LAB: PowerShell process executed with SOC-LAB-TEST-002 marker</description>
    <group>sysmon_event1,custom_detection,</group>
  </rule>
</group>
